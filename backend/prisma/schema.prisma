// Prisma — SQLite em dev (file:./dev.db); PostgreSQL em produção (Render).
// O script scripts/sync-prisma-provider.js ajusta o provider conforme DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // Identificador único na URL (ex: 'empresa-a')
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  financeIntegrations FinanceIntegration[]

  @@map("tenants")
}

/// Papel do utilizador. O serviço valida ADM | GESTOR | TECNICO | FUNCIONARIO.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String
  passwordHash String
  /// Senha definida pelo utilizador para confirmar ações sensíveis (independente do login Google).
  hasConfirmationPassword Boolean @default(false)
  role         String   @default("TECNICO")
  /// Área/setor da empresa (ex.: RH, Financeiro) — definido pelo ADM
  department   String?
  /// Nome do ficheiro em /uploads (foto de perfil definida pelo próprio utilizador)
  avatarFilename String?
  /// URL externa da foto (preenchida a partir do Google no primeiro login, se não houver foto local)
  avatarExternalUrl String?
  active       Boolean  @default(true)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@map("users")
}

model FinanceIntegration {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  kind         String   @default("FINANCE")
  baseUrl      String   @default("")
  endpointPath String?
  authType     String   @default("Bearer")
  /// JSON com credenciais (token, apiKey, clientId, etc.)
  authConfig   String   @default("{}")
  /// JSON com cabeçalhos HTTP adicionais
  extraHeaders String   @default("{}")
  notes        String?
  active       Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@map("finance_integrations")
}
