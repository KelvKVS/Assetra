PORT=3000
CORS_ORIGIN=http://localhost:5173,https://seu-frontend.vercel.app
JWT_SECRET=troque-por-um-segredo-forte-com-32-caracteres-ou-mais
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=cole-o-segredo-do-cliente-oauth-web
FRONTEND_URL=http://localhost:5173

# E-mail (convite + notificações)
# Remetente padrão (obrigatório; deve ser verificado na Resend ou conta Gmail do SMTP).
EMAIL_FROM=kelvinkv2030@gmail.com
# Produção no Render FREE: SMTP Gmail NÃO funciona (portas 587/465 bloqueadas). Use Resend:
# RESEND_API_KEY=re_xxxxxxxx  (https://resend.com → API Keys)
# RESEND_FROM="Assetra <kelvinkv2030@gmail.com>"  (opcional; e-mail verificado na Resend)
# Localhost: SMTP Gmail funciona normalmente:
# EMAIL_DEV_ETHEREAL=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=kelvinkv2030@gmail.com
# SMTP_PASS=senhaaplicacaogoogle16chars
# SMTP_FROM="Assetra <kelvinkv2030@gmail.com>"
# Enviar notificações do sistema por e-mail (via RabbitMQ + worker)
NOTIFICATION_EMAILS_ENABLED=true
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
API_PUBLIC_URL=http://localhost:3000
# Limite por ficheiro (bytes). Padrão: 800 MB
# MAX_UPLOAD_FILE_BYTES=838860800
# MAX_UPLOAD_FILES=6

# Prisma — relacional
# Dev local (SQLite, sem instalar Postgres):
DATABASE_URL="file:./dev.db"
# Produção / Docker (PostgreSQL — o script sync-prisma-provider.js ajusta o schema):
# DATABASE_URL="postgresql://usuario:senha@host:5432/assetra?schema=public"

# MongoDB (Mongoose — inventário, histórico, aprovações)
MONGODB_URL="mongodb+srv://usuario:senha@cluster.mongodb.net/assetra?retryWrites=true&w=majority"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
EVENT_BROKER_DRIVER="rabbitmq" # rabbitmq | kafka
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="assetra-app"
KAFKA_TOPIC="assetra.events"
# Opção 1 (recomendada): chaves por tenant (formato tenantId:apiKey,tenantId2:apiKey2)
INTEGRATION_API_KEYS=""
# Opção 2 (legado): chave única + tenant fixo
INTEGRATION_API_KEY="troque-por-uma-chave-forte-para-integracoes"
INTEGRATION_TENANT_ID=""

NODE_ENV=development
