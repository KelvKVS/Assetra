# Mesmo Client ID do backend (login Google + importação ADM)
# Login na página usa redirect no backend — ver docs/configurar-google-login.md
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# Em dev com Vite: use /api (proxy). Em produção: URL completa do backend.
VITE_API_BASE_URL=/api
