# Mesmo Client ID do backend (login Google + importação ADM)
# Login na página usa redirect no backend — ver docs/configurar-google-login.md
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# Em dev: /api (proxy Vite). Na Vercel com rewrite em vercel.json: também /api.
# Sem rewrite na Vercel: use a URL completa do Render, ex. https://assetra-44la.onrender.com/api
VITE_API_BASE_URL=/api
# Uploads > ~4 MB na Vercel: URL direta do backend Render (evita limite do proxy)
# VITE_API_UPLOAD_BASE_URL=https://assetra-44la.onrender.com/api
